sshagent(['f5c87d72-b77d-4978-9d6e-1c5451060fb2']) {
   sh "scp -o StrictHostKeyChecking=no target/maven-web-application.war  ec2-user@172.31.5.188:/opt/apache-tomcat-9.0.98/webapps/"   
